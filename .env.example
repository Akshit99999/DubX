# Copy to .env or set these variables in your shell. Never commit real keys.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3
SARVAM_API_KEY=your_sarvam_api_key_here

# edge is the default zero-key TTS backend (requires network access).
DUBX_TTS_BACKEND=edge
DUBX_HOST=127.0.0.1
DUBX_PORT=7860
