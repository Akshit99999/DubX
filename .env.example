# Copy to .env or set these variables in your shell. Never commit real keys.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam Bulbul is the only synthesis backend. Source-speaker cloning is
# explicitly selected in the UI and requires the rights-holder's consent.
DUBX_TTS_BACKEND=sarvam
DUBX_SARVAM_SPEAKER=
# Fast video defaults: 720p YouTube download, no Demucs stem separation, tiny
# local Whisper fallback. Set DUBX_FAST_MODE=0 and DUBX_PRESERVE_BGM=1 for the
# slower full-quality stem-separated path.
DUBX_FAST_MODE=1
DUBX_YOUTUBE_MAX_HEIGHT=720
DUBX_WHISPER_MODEL=tiny
DUBX_PRESERVE_BGM=0
DUBX_HOST=127.0.0.1
DUBX_PORT=7860
